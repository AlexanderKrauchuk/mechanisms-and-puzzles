<div class="map-manager-content">
  <header class="map-heading">
    <h2>{{localize "MAP.Manager.Title"}}</h2>
    <p>{{localize "MAP.Manager.Intro"}}</p>
  </header>

  <section class="map-panel">
    <h3>{{localize "MAP.Manager.Environment"}}</h3>

    <dl class="map-diagnostics">
      <dt>{{localize "MAP.Manager.ModuleVersion"}}</dt>
      <dd>{{moduleVersion}}</dd>

      <dt>{{localize "MAP.Manager.FoundryVersion"}}</dt>
      <dd>{{foundryVersion}}</dd>

      <dt>{{localize "MAP.Manager.System"}}</dt>
      <dd>{{systemTitle}}</dd>

      <dt>{{localize "MAP.Manager.Scene"}}</dt>
      <dd>{{sceneName}}</dd>

      <dt>{{localize "MAP.Manager.ActiveGMs"}}</dt>
      <dd>{{activeGMNames}}</dd>
    </dl>
  </section>

  <p class="map-notice">{{localize "MAP.Manager.SecurityNotice"}}</p>

  {{#if storageError}}
    <p class="map-error">{{storageError}}</p>
  {{/if}}

  <section class="map-panel">
    <div class="map-section-heading">
      <h3>{{localize "MAP.Manager.Puzzles"}}</h3>

      <button type="button" data-action="create">
        <i class="fas fa-plus" aria-hidden="true"></i>
        {{localize "MAP.Buttons.Create"}}
      </button>
    </div>

    {{#each puzzles}}
      <article class="map-puzzle-card">
        <h4>{{name}}</h4>

        <p class="map-help">{{typeLabel}} · {{statusLabel}}</p>

        {{#if description}}
          <p class="map-description">{{description}}</p>
        {{/if}}

        <div class="map-card-actions">
          <button
            type="button"
            data-action="edit"
            data-puzzle-id="{{id}}"
          >
            {{localize "MAP.Buttons.Edit"}}
          </button>

          <button
            type="button"
            data-action="reset"
            data-puzzle-id="{{id}}"
          >
            {{localize "MAP.Buttons.Reset"}}
          </button>

          <button
            type="button"
            data-action="delete"
            data-puzzle-id="{{id}}"
          >
            {{localize "MAP.Buttons.Delete"}}
          </button>
        </div>
      </article>
    {{else}}
      <p>{{localize "MAP.Manager.Empty"}}</p>
    {{/each}}
  </section>

  <footer class="map-footer">
    <button type="button" data-action="refresh">
      <i class="fas fa-arrows-rotate" aria-hidden="true"></i>
      {{localize "MAP.Buttons.Refresh"}}
    </button>
  </footer>
</div>
