<section class="map-puzzle">
  {{#if missing}}
    <p class="map-missing">{{localize "mechanisms-and-puzzles.puzzle.missing"}}</p>
  {{else}}
    {{#if puzzle.description}}
      <p class="map-description">{{puzzle.description}}</p>
    {{/if}}

    {{#if accessNote}}
      <p class="map-note" role="status"><i class="fa-solid fa-lock"></i> {{accessNote}}</p>
    {{/if}}

    {{#if solved}}
      <p class="map-banner map-solved">{{localize "mechanisms-and-puzzles.puzzle.solved"}}</p>
    {{/if}}

    {{#if sequence}}
      <div class="map-slots" role="list">
        {{#each sequence.slots}}
          <span class="map-slot{{#if this.filled}} filled{{/if}}" role="listitem">{{this.label}}</span>
        {{/each}}
      </div>

      <div class="map-symbols">
        {{#each sequence.symbols}}
          <button type="button" class="map-symbol" data-action="press" data-symbol="{{this.id}}" {{#if this.disabled}}disabled{{/if}}>{{this.label}}</button>
        {{/each}}
      </div>

      <div class="map-controls">
        <button type="button" data-action="clear" {{#if solved}}disabled{{/if}}>
          <i class="fa-solid fa-rotate-left"></i> {{localize "mechanisms-and-puzzles.puzzle.clear"}}
        </button>
        <span class="map-mistakes">{{localize "mechanisms-and-puzzles.puzzle.mistakes"}}: {{sequence.mistakes}}</span>
      </div>
    {{/if}}

    {{#if sliding}}
      <div class="map-board" style="--map-cols: {{sliding.cols}}">
        {{#each sliding.cells}}
          {{#if this.empty}}
            <span class="map-cell map-empty-cell"></span>
          {{else}}
            <button type="button" class="map-cell map-tile{{#if this.movable}} movable{{/if}}" data-action="slide" data-index="{{this.index}}" {{#if this.disabled}}disabled{{/if}}>{{this.value}}</button>
          {{/if}}
        {{/each}}
      </div>

      <div class="map-controls">
        <span class="map-moves">{{localize "mechanisms-and-puzzles.puzzle.moves"}}: {{sliding.moves}}</span>
      </div>
    {{/if}}

    {{#if rings}}
      <svg class="map-rings" viewBox="0 -12 300 312" role="img" aria-label="{{localize "mechanisms-and-puzzles.puzzle.ringsAria"}}" style="--map-font: {{rings.fontSize}}px">
        {{#each rings.rings}}
          <g class="map-ring">
            {{#each this.sectors}}
              <path class="map-sector{{#if this.pointer}} pointer{{/if}}" d="{{this.d}}"></path>
              <text class="map-sector-label{{#if this.pointer}} pointer{{/if}}" x="{{this.x}}" y="{{this.y}}" text-anchor="middle" dominant-baseline="central">{{this.label}}</text>
            {{/each}}
          </g>
        {{/each}}
        <polygon class="map-pointer" points="141,-12 159,-12 150,0"></polygon>
      </svg>

      <ul class="map-ring-controls">
        {{#each rings.rings}}
          <li class="map-ring-row">
            <span class="map-ring-name">{{localize "mechanisms-and-puzzles.puzzle.ring"}} {{this.number}}</span>
            <button type="button" data-action="rotate" data-ring="{{this.ring}}" data-direction="1" title="{{localize "mechanisms-and-puzzles.puzzle.rotateLeft"}}" aria-label="{{localize "mechanisms-and-puzzles.puzzle.rotateLeft"}}" {{#if this.disabled}}disabled{{/if}}><i class="fa-solid fa-rotate-left"></i></button>
            <span class="map-ring-current">{{this.current}}</span>
            <button type="button" data-action="rotate" data-ring="{{this.ring}}" data-direction="-1" title="{{localize "mechanisms-and-puzzles.puzzle.rotateRight"}}" aria-label="{{localize "mechanisms-and-puzzles.puzzle.rotateRight"}}" {{#if this.disabled}}disabled{{/if}}><i class="fa-solid fa-rotate-right"></i></button>
          </li>
        {{/each}}
      </ul>

      <div class="map-controls">
        {{#if rings.confirm}}
          <button type="button" data-action="check" {{#if solved}}disabled{{/if}}>
            <i class="fa-solid fa-check"></i> {{localize "mechanisms-and-puzzles.puzzle.check"}}
          </button>
          <span class="map-moves">{{localize "mechanisms-and-puzzles.puzzle.attempts"}}: {{rings.attempts}}</span>
        {{else}}
          <span class="map-moves">{{localize "mechanisms-and-puzzles.puzzle.moves"}}: {{rings.moves}}</span>
        {{/if}}
      </div>
    {{/if}}

    {{#if hints.length}}
      <details class="map-hints">
        <summary>{{localize "mechanisms-and-puzzles.puzzle.hints"}}</summary>
        <ul>
          {{#each hints}}
            <li>{{this}}</li>
          {{/each}}
        </ul>
      </details>
    {{/if}}
  {{/if}}
</section>
